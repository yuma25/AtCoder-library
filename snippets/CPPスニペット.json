{
  "Competitive Programming Template Complete": {
    "prefix": "cp",
    "body": [
      "#include <bits/stdc++.h>",
      "using namespace std;",
      "",
      "// --- 型エイリアス ---",
      "using ll = long long;",
      "using ull = unsigned long long;",
      "using ld = long double;",
      "using vi = vector<int>;",
      "using vl = vector<ll>;",
      "using vvi = vector<vi>;",
      "using vvl = vector<vl>;",
      "using pii = pair<int, int>;",
      "using pll = pair<ll, ll>;",
      "using vpii = vector<pii>;",
      "using vpll = vector<pll>;",
      "",
      "// --- 定数 ---",
      "const ll INF = 1e18;",
      "const int INF_INT = 1e9;",
      "const int MOD = 998244353;",
      "const int MOD_OLD = 1e9 + 7;",
      "const double PI = std::numbers::pi;",
      "",
      "const int dx4[] = {0, 1, 0, -1};",
      "const int dy4[] = {1, 0, -1, 0};",
      "const int dx8[] = {0, 1, 0, -1, 1, 1, -1, -1};",
      "const int dy8[] = {1, 0, -1, 0, 1, -1, 1, -1};",
      "",
      "// --- 便利マクロ ---",
      "#define rep(i, n) for (int i = 0; i < (int)(n); ++i)",
      "#define reps(i, s, n) for (int i = (int)(s); i < (int)(n); ++i)",
      "#define rrep(i, n) for (int i = (int)(n) - 1; i >= 0; --i)",
      "#define all(v) (v).begin(), (v).end()",
      "#define rall(v) (v).rbegin(), (v).rend()",
      "#define pb push_back",
      "#define eb emplace_back",
      "#define fi first",
      "#define se second",
      "",
      "// --- 入出力高速化 ---",
      "struct FastIO {",
      "    FastIO() {",
      "        ios::sync_with_stdio(false);",
      "        cin.tie(nullptr);",
      "        cout << fixed << setprecision(15);",
      "    }",
      "} fast_io;",
      "",
      "// --- 便利関数 ---",
      "template<typename T> inline bool chmax(T &a, T b) { if (a < b) { a = b; return true; } return false; }",
      "template<typename T> inline bool chmin(T &a, T b) { if (a > b) { a = b; return true; } return false; }",
      "inline bool in_grid(int r, int c, int h, int w) { return 0 <= r && r < h && 0 <= c && c < w; }",
      "",
      "// --- 数学・アルゴリズム集 ---",
      "ll pow_mod(ll a, ll n, ll m = MOD) {",
      "    ll res = 1;",
      "    a = (a % m + m) % m;",
      "    while (n > 0) {",
      "        if (n & 1) res = res * a % m;",
      "        a = a * a % m;",
      "        n >>= 1;",
      "    }",
      "    return res;",
      "}",
      "",
      "ll inv_mod(ll a, ll m = MOD) {",
      "    return pow_mod(a, m - 2, m);",
      "}",
      "",
      "template<int m = MOD>",
      "struct Combination {",
      "    vl fact, inv;",
      "    Combination(int n) : fact(n + 1), inv(n + 1) {",
      "        fact[0] = 1;",
      "        for (int i = 1; i <= n; i++) fact[i] = fact[i - 1] * i % m;",
      "        inv[n] = pow_mod(fact[n], m - 2, m);",
      "        for (int i = n - 1; i >= 0; i--) inv[i] = inv[i + 1] * (i + 1) % m;",
      "    }",
      "    ll nCr(int n, int r) {",
      "        if (r < 0 || r > n) return 0;",
      "        return fact[n] * inv[r] % m * inv[n - r] % m;",
      "    }",
      "};",
      "",
      "int main() {",
      "    $0",
      "    ",
      "    return 0;",
      "}"
    ],
    "description": "AtCoder C++ Template Complete"
  },
