  "Binary Search (Decision Problem)": {
    "prefix": "binsearch",
    "body": [
      "auto check = [&](long long x) -> bool {",
      "    // ${1:判定ロジック}",
      "    return true;",
      "};",
      "long long ok = ${2:0};",
      "long long ng = ${3:1e18};",
      "while (abs(ok - ng) > 1) {",
      "    long long mid = ok + (ng - ok) / 2;",
      "    if (check(mid)) ok = mid;",
      "    else ng = mid;",
      "}"
    ],
    "description": "Binary Search template for decision problems"
  },
  "BFS Graph Shortest Path": {
    "prefix": "bfs",
    "body": [
      "vector<int> dist(${1:n}, -1);",
      "queue<int> que;",
      "dist[${2:0}] = 0;",
      "que.push(${2:0});",
      "while (!que.empty()) {",
      "    int v = que.front(); que.pop();",
      "    for (int nv : ${3:G}[v]) {",
      "        if (dist[nv] != -1) continue;",
      "        dist[nv] = dist[v] + 1;",
      "        que.push(nv);",
      "    }",
      "}"
    ],
    "description": "BFS for graph shortest path"
  },
  "BFS Grid Shortest Path": {
    "prefix": "gridbfs",
    "body": [
      "vector<vector<int>> dist(${1:h}, vector<int>(${2:w}, -1));",
      "queue<pair<int, int>> que;",
      "dist[${3:sy}][${4:sx}] = 0;",
      "que.push({${3:sy}, ${4:sx}});",
      "while (!que.empty()) {",
      "    auto [r, c] = que.front(); que.pop();",
      "    for (int i = 0; i < 4; ++i) {",
      "        int nr = r + dx4[i];",
      "        int nc = c + dy4[i];",
      "        if (!in_grid(nr, nc, ${1:h}, ${2:w})) continue;",
      "        if (${5:grid}[nr][nc] == '#') continue;",
      "        if (dist[nr][nc] != -1) continue;",
      "        dist[nr][nc] = dist[r][c] + 1;",
      "        que.push({nr, nc});",
      "    }",
      "}"
    ],
    "description": "BFS on 2D grid"
  },
  "Dijkstra Algorithm": {
    "prefix": "dijkstra",
    "body": [
      "struct Edge {",
      "    int to;",
      "    long long cost;",
      "};",
      "vector<long long> dist(${1:n}, INF);",
      "priority_queue<pair<long long, int>, vector<pair<long long, int>>, greater<pair<long long, int>>> pq;",
      "dist[${2:0}] = 0;",
      "pq.push({0, ${2:0}});",
      "while (!pq.empty()) {",
      "    auto [d, v] = pq.top(); pq.pop();",
      "    if (dist[v] < d) continue;",
      "    for (const auto& e : ${3:G}[v]) {",
      "        if (chmin(dist[e.to], dist[v] + e.cost)) {",
      "            pq.push({dist[e.to], e.to});",
      "        }",
      "    }",
      "}"
    ],
    "description": "Dijkstra algorithm for shortest path"
  },
  "Union-Find (Disjoint Set Union)": {
    "prefix": "unionfind",
    "body": [
      "struct UnionFind {",
      "    vector<int> par, siz;",
      "    UnionFind(int n) : par(n, -1), siz(n, 1) {}",
      "    int root(int x) {",
      "        if (par[x] == -1) return x;",
      "        return par[x] = root(par[x]);",
      "    }",
      "    bool same(int x, int y) { return root(x) == root(y); }",
      "    bool unite(int x, int y) {",
      "        x = root(x); y = root(y);",
      "        if (x == y) return false;",
      "        if (siz[x] < siz[y]) swap(x, y);",
      "        par[y] = x;",
      "        siz[x] += siz[y];",
      "        return true;",
      "    }",
      "    int size(int x) { return siz[root(x)]; }",
      "};"
    ],
    "description": "Union-Find (DSU) struct"
  },
  "Coordinate Compression": {
    "prefix": "compression",
    "body": [
      "auto compress = [](vector<${1:long long}> &A) {",
      "    vector<${1:long long}> vals = A;",
      "    sort(vals.begin(), vals.end());",
      "    vals.erase(unique(vals.begin(), vals.end()), vals.end());",
      "    vector<int> res(A.size());",
      "    for (int i = 0; i < (int)A.size(); ++i) {",
      "        res[i] = lower_bound(vals.begin(), vals.end(), A[i]) - vals.begin();",
      "    }",
      "    return make_pair(res, vals);",
      "};"
    ],
    "description": "Coordinate compression"
  },
  "Run Length Encoding": {
    "prefix": "rle",
    "body": [
      "auto run_length_encoding = [](const string &S) {",
      "    vector<pair<char, int>> res;",
      "    if (S.empty()) return res;",
      "    res.push_back({S[0], 1});",
      "    for (int i = 1; i < (int)S.size(); ++i) {",
      "        if (S[i] == res.back().first) {",
      "            res.back().second++;",
      "        } else {",
      "            res.push_back({S[i], 1});",
      "        }",
      "    }",
      "    return res;",
      "};"
    ],
    "description": "Run length encoding for strings"
  },
  "Prime Factorization": {
    "prefix": "primefactor",
    "body": [
      "auto prime_factorize = [](long long n) {",
      "    vector<pair<long long, int>> res;",
      "    for (long long p = 2; p * p <= n; ++p) {",
      "        if (n % p != 0) continue;",
      "        int num = 0;",
      "        while (n % p == 0) {",
      "            ++num;",
      "            n /= p;",
      "        }",
      "        res.push_back({p, num});",
      "    }",
      "    if (n > 1) res.push_back({n, 1});",
      "    return res;",
      "};"
    ],
    "description": "Prime factorization"
  },
  "Divisors Enumeration": {
    "prefix": "divisors",
    "body": [
      "auto get_divisors = [](long long n) {",
      "    vector<long long> res;",
      "    for (long long i = 1; i * i <= n; ++i) {",
      "        if (n % i == 0) {",
      "            res.push_back(i);",
      "            if (i * i != n) res.push_back(n / i);",
      "        }",
      "    }",
      "    sort(res.begin(), res.end());",
      "    return res;",
      "};"
    ],
    "description": "Divisors enumeration"
  },
  "Combination Struct": {
    "prefix": "combination",
    "body": [
      "struct Combination {",
      "    vector<long long> fact, inv;",
      "    long long mod;",
      "    Combination(int n, long long m = 998244353) : fact(n + 1), inv(n + 1), mod(m) {",
      "        fact[0] = 1;",
      "        for (int i = 1; i <= n; i++) fact[i] = fact[i - 1] * i % mod;",
      "        inv[n] = mod_pow(fact[n], mod - 2);",
      "        for (int i = n - 1; i >= 0; i--) inv[i] = inv[i + 1] * (i + 1) % mod;",
      "    }",
      "    long long mod_pow(long long a, long long n) {",
      "        long long res = 1; a %= mod;",
      "        while (n > 0) {",
      "            if (n & 1) res = res * a % mod;",
      "            a = a * a % mod; n >>= 1;",
      "        }",
      "        return res;",
      "    }",
      "    long long nCr(int n, int r) {",
      "        if (r < 0 || r > n) return 0;",
      "        return fact[n] * inv[r] % mod * inv[n - r] % mod;",
      "    }",
      "};"
    ],
    "description": "Combination (nCr) struct with precomputation"
  },
