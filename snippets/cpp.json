      "for (int i = 0; i < (int)(${3:m}); ++i) {",
      "    int u, v; cin >> u >> v;",
      "    --u; --v;",
      "    ${1:G}[u].push_back(v);",
      "    ${1:G}[v].push_back(u);",
      "}"
    ],
    "description": "Read undirected graph adjacency list (0-indexed)"
  },
