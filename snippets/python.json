  "Combination Table": {
    "prefix": "combination",
    "body": [
      "class Combination:",
      "    def __init__(self, n, mod=998244353):",
      "        self.mod = mod",
      "        self.fact = [1] * (n + 1)",
      "        self.inv = [1] * (n + 1)",
      "        for i in range(1, n + 1):",
      "            self.fact[i] = (self.fact[i - 1] * i) % mod",
      "        self.inv[n] = pow(self.fact[n], mod - 2, mod)",
      "        for i in range(n - 1, -1, -1):",
      "            self.inv[i] = (self.inv[i + 1] * (i + 1)) % mod",
      "",
      "    def nCr(self, n, r):",
      "        if r < 0 or n < r:",
      "            return 0",
      "        return self.fact[n] * self.inv[r] % self.mod * self.inv[n - r] % self.mod"
    ],
    "description": "Combination (nCr) class with precomputed factorials"
  }
