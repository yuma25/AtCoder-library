  "Prime Factorization": {
    "prefix": "primefactor",
    "body": [
      "def prime_factorize(n):",
      "    res = []",
      "    p = 2",
      "    while p * p <= n:",
      "        if n % p == 0:",
      "            cnt = 0",
      "            while n % p == 0:",
      "                cnt += 1",
      "                n //= p",
      "            res.append((p, cnt))",
      "        p += 1",
      "    if n > 1:",
      "        res.append((n, 1))",
      "    return res"
    ],
    "description": "Prime factorization function"
  },
  "Divisors Enumeration": {
    "prefix": "divisors",
